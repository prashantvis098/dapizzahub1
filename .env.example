# Database (required — this is how orders get saved and show up on
# /admin/orders). Get a free connection string from https://neon.tech
# (no credit card required), or use Vercel Postgres / Supabase / your own
# Postgres. See src/lib/db.ts for full setup instructions.
DATABASE_URL=

# Admin Orders page (required to view/manage orders at /admin/orders).
# ADMIN_PASSWORD: the password restaurant staff will type in to log in.
# ADMIN_SESSION_SECRET: any long random string — generate one with:
#   openssl rand -base64 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Petpooja Integration (optional — leave blank for demo/dev)
# Required only when you're ready to push live orders into Petpooja.
# See src/lib/petpooja.ts for full documentation.
PETPOOJA_API_KEY=
PETPOOJA_RESTAURANT_ID=
